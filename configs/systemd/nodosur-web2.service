[Unit]
Description=Nodo Sur - WordPress Backend 2
Wants=network-online.target
After=network-online.target docker.service nodosur-docker-firewall-web2.service
Requires=docker.service nodosur-docker-firewall-web2.service
PartOf=docker.service
RequiresMountsFor=/srv/nodosur/nfs/uploads

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/nodosur
ExecStartPre=/usr/local/sbin/nodosur-check-web-storage web2
ExecStartPre=/usr/bin/docker compose -f compose/web2/compose.yaml config --quiet
ExecStart=/usr/bin/docker compose -f compose/web2/compose.yaml up -d
ExecStop=/usr/bin/docker compose -f compose/web2/compose.yaml stop
TimeoutStartSec=120
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
