[Unit]
Description=Nodo Sur - WordPress Backend 1
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
RequiresMountsFor=/srv/nodosur/nfs/uploads

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/tas_revision/nodosur-tas-grupo7
ExecStartPre=/usr/bin/mountpoint -q /srv/nodosur/nfs/uploads
ExecStart=/usr/bin/docker compose -f compose/web1/compose.yaml up -d
ExecStop=/usr/bin/docker compose -f compose/web1/compose.yaml stop
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
