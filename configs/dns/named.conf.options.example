// Fragmento saneado con opciones verificadas durante la implementación.
// No pretende reemplazar íntegramente /etc/bind/named.conf.options.

acl "nodosur-clients" {
    localhost;
    10.30.248.0/24;
    10.33.199.56/29;
    10.33.21.0/24;
};

options {
    directory "/var/cache/bind";

    recursion no;
    allow-transfer { none; };
    listen-on-v6 { none; };
    allow-query { nodosur-clients; };

    listen-on {
        127.0.0.1;
        10.33.195.205;
        10.33.199.59;
    };

    // Otras opciones del archivo real se omiten en este ejemplo saneado.
};
